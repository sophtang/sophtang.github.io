---
layout: default
news: true
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="desc">{{ page.subtitle }}</p>
  </header>

  <article>
    {% if page.profile %}
      <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle image-spacing' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1
      rounded image-spacing' %}
          {% endif %}
          {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px)
      30vw, 95vw"{% endcapture %}
          {%
            include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
            cache_bust=true
          %}
        {% endif %}
        <div class="profile-social">{% include social.liquid %}</div>
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="clearfix">{{ content }}</div>

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <hr class="section-divider">
      <h2>Updates</h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <hr class="section-divider">
      <h2 class="section-heading">
        <a class="section-link hover-reveal" href="{{ '/publications/' | relative_url }}" aria-label="Selected Publications: see all papers">
          <span class="section-link-label hover-reveal-label">Selected Publications</span><span class="hover-more-anchor" aria-hidden="true"><span class="hover-more">
            <span class="more-text">all papers</span>
            <span class="more-arrow">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="4" y1="12" x2="20" y2="12"></line>
                <polyline points="13 5 20 12 13 19"></polyline>
              </svg>
            </span>
          </span></span>
        </a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- Invited talks -->
    {% if page.invited_talks %}
      <hr class="section-divider">
      <h2 class="section-heading">Invited Talks</h2>
      {% include selected_talks.liquid %}
    {% endif %}

    <!-- Technical articles -->
    {% if page.technical_articles %}
      <h2 class="section-heading">
        <a class="section-link hover-reveal" href="{{ '/articles/' | relative_url }}" aria-label="Selected Articles: see all articles">
          <span class="section-link-label hover-reveal-label">Selected Articles</span><span class="hover-more-anchor" aria-hidden="true"><span class="hover-more">
            <span class="more-text">all articles</span>
            <span class="more-arrow">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="4" y1="12" x2="20" y2="12"></line>
                <polyline points="13 5 20 12 13 19"></polyline>
              </svg>
            </span>
          </span></span>
        </a>
      </h2>
      {% include selected_articles.liquid %}
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <hr class="section-divider">
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter.enabled and site.footer_fixed %}
      {% include scripts/newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
